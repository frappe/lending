#. Content of the 'Help Text' (HTML) field in DocType 'Process Loan Statement
#. of Accounts'
#: lending/loan_management/doctype/process_loan_statement_of_accounts/process_loan_statement_of_accounts.json
#, python-format
msgid "<br>\n"
"<h4>Note</h4>\n"
"<ul>\n"
"<li>\n"
"You can use <a href=\"https://jinja.palletsprojects.com/en/2.11.x/\" target=\"_blank\">Jinja tags</a> in <b>Subject</b>, <b>Body</b> and <b>PDF Name</b> fields for dynamic values.\n"
"</li><li>\n"
"    All fields in this doctype are available under the <b>doc</b> object and the applicant row is available under the <b>applicant</b> object (fields: applicant, applicant_name, email).\n"
"</li></ul>\n"
"<h4> Examples</h4>\n"
"<!-- {% raw %} -->\n"
"<ul>\n"
"    <li><b>Subject</b>:<br><br><pre><code>Loan Statement Of Account for {{ applicant.applicant_name }}</code></pre><br></li>\n"
"    <li><b>Body</b>: <br><br>\n"
"<pre><code>Hello {{ applicant.applicant_name }},<br>PFA your Loan Statement Of Account from {{ doc.from_date }} to {{ doc.to_date }}.</code> </pre></li>\n"
"</ul>\n"
"<!-- {% endraw %} -->"
msgstr "<br>\n"
"<h4>Тэмдэглэл</h4>\n"
"<ul>\n"
"<li>\n"
"Та <a href=\"https://jinja.palletsprojects.com/en/2.11.x/\" target=\"_blank\">Жинжа таг</a> -г <b>гарчиг</b>дотор ашиглаж болно, Динамик утгуудын <b>Үндсэн хэсэг</b> болон <b>PDF нэр</b> талбарууд.\n"
"</li><li>\n"
"    Энэ баримт бичгийн төрөл дэх бүх талбарууд <b>баримт бичгийн</b> объектын доор, өргөдөл гаргагчийн мөр нь <b>өргөдөл гаргагчийн</b> объектын доор байна (талбарууд: өргөдөл гаргагч, өргөдөл гаргагчийн_нэр, имэйл).\n"
"</li></ul>\n"
"<h4> Жишээнүүд</h4>\n"
"<!-- {% raw %} -->\n"
"<ul>\n"
"    <li><b>Гарчиг</b>:<br><br><pre><code> {{ applicant.applicant_name }}-н зээлийн дансны тайлан</code></pre><br></li>\n"
"    <li><b>Үндсэн хэсэг</b>: <br><br>\n"
"<pre><code>Сайн байна уу {{ applicant.applicant_name }},<br>Зээлийн тайлангаа PFA-аар баталгаажуулна уу {{ doc.from_date }} -с {{ doc.to_date }}хүртэлх бүртгэл.</code> </pre></li>\n"
"</ul>\n"
"<!-- {% endraw %} -->"

