#. Content of the 'Help Text' (HTML) field in DocType 'Process Loan Statement
#. of Accounts'
#: lending/loan_management/doctype/process_loan_statement_of_accounts/process_loan_statement_of_accounts.json
#, python-format
msgid "<br>\n"
"<h4>Note</h4>\n"
"<ul>\n"
"<li>\n"
"You can use <a href=\"https://jinja.palletsprojects.com/en/2.11.x/\" target=\"_blank\">Jinja tags</a> in <b>Subject</b>, <b>Body</b> and <b>PDF Name</b> fields for dynamic values.\n"
"</li><li>\n"
"    All fields in this doctype are available under the <b>doc</b> object and the applicant row is available under the <b>applicant</b> object (fields: applicant, applicant_name, email).\n"
"</li></ul>\n"
"<h4> Examples</h4>\n"
"<!-- {% raw %} -->\n"
"<ul>\n"
"    <li><b>Subject</b>:<br><br><pre><code>Loan Statement Of Account for {{ applicant.applicant_name }}</code></pre><br></li>\n"
"    <li><b>Body</b>: <br><br>\n"
"<pre><code>Hello {{ applicant.applicant_name }},<br>PFA your Loan Statement Of Account from {{ doc.from_date }} to {{ doc.to_date }}.</code> </pre></li>\n"
"</ul>\n"
"<!-- {% endraw %} -->"
msgstr "<br>\n"
"<h4>Nota</h4>\n"
"<ul>\n"
"<li>\n"
"Puedes usar <a href=\"https://jinja.palletsprojects.com/en/2.11.x/\" target=\"_blank\">etiquetas Jinja</a> en los campos <b>Asunto</b>, <b>Cuerpo</b> y <b>Nombre del PDF</b> para valores dinámicos.\n"
"</li><li>\n"
"    Todos los campos de este doctype están disponibles bajo el objeto <b>doc</b> y la fila del solicitante está disponible bajo el objeto <b>applicant</b> (campos: applicant, applicant_name, email).\n"
"</li></ul>\n"
"<h4> Ejemplos</h4>\n"
"<!-- {% raw %} -->\n"
"<ul>\n"
"    <li><b>Asunto</b>:<br><br><pre><code>Extracto de cuenta del préstamo de {{ applicant.applicant_name }}</code></pre><br></li>\n"
"    <li><b>Cuerpo</b>: <br><br>\n"
"<pre><code>Hola {{ applicant.applicant_name }},<br>Adjuntamos tu extracto de cuenta del préstamo del {{ doc.from_date }} al {{ doc.to_date }}.</code> </pre></li>\n"
"</ul>\n"
"<!-- {% endraw %} -->"

